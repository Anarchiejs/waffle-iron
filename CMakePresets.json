{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "cpu-debug",
      "inherits": "base",
      "displayName": "CPU, Debug (day-to-day development, tests)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "WAFFLE_CUDA": "OFF" }
    },
    {
      "name": "cpu-release",
      "inherits": "base",
      "displayName": "CPU, Release (CI)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "WAFFLE_CUDA": "OFF" }
    },
    {
      "name": "cuda-release",
      "inherits": "base",
      "displayName": "CUDA, Release (sm_89)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "WAFFLE_CUDA": "ON",
        "CMAKE_CUDA_ARCHITECTURES": "89"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "CPU, Debug + AddressSanitizer",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "WAFFLE_CUDA": "OFF", "WAFFLE_ASAN": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "cpu-debug", "configurePreset": "cpu-debug" },
    { "name": "cpu-release", "configurePreset": "cpu-release" },
    { "name": "cuda-release", "configurePreset": "cuda-release" },
    { "name": "asan", "configurePreset": "asan" }
  ],
  "testPresets": [
    { "name": "cpu-debug", "configurePreset": "cpu-debug", "output": { "outputOnFailure": true } },
    { "name": "cpu-release", "configurePreset": "cpu-release", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } }
  ]
}
